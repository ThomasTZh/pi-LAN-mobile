[Desktop Entry]
Type=Application
Version=1.0
Name=Pi Mobile: server + CLI
Comment=Start the Pi LAN host and open the Pi CLI in one terminal window
Exec=@KONSOLE@ --hold -e @REPO@/server/scripts/pi-live.sh
Path=@REPO@
Icon=@REPO@/server/launcher/pi-mobile.svg
Terminal=false
Categories=Development;
StartupNotify=true
Keywords=pi;agent;mobile;lan;pocket;
