<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- API 34+ rejects a connectedDevice foreground service unless the app also
         holds one of the "connected device" qualifier permissions. This was the
         only install-time (non-runtime) option for a LAN socket; without it
         PiAlertsService crashed the process on the first Alerts toggle with a
         SecurityException from setServiceForeground (device: ASUS_AI2302, API 35). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Settings > Device points the user at the system battery-optimisation
         exemption so the foreground service survives aggressive OEM managers
         (PLAN.md 5.6, review F9). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Android 17 gates local-network sockets behind this runtime permission. The app targets
         36 (legacy implicit grant) for now, so it declares but does not request it yet. -->
    <uses-permission
        android:name="android.permission.ACCESS_LOCAL_NETWORK"
        tools:targetApi="37" />

    <!-- dataExtractionRules applies from API 31; on API 29/30 it is ignored by
         the platform, which is what the lint note records. Keep it for 12+. -->
    <application
        android:name=".PiMobileApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_pi"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_pi"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiMobile"
        android:usesCleartextTraffic="true"
        tools:ignore="DataExtractionRules"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.PiAlertsService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false" />
    </application>
</manifest>
